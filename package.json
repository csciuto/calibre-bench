{
  "name": "calibre-bench",
  "private": true,
  "scripts": {
    "serve": "python3 -m http.server 8094",
    "test": "node --test 'tests/*.test.js'",
    "test:unit": "node --test 'tests/*.test.js'",
    "test:e2e": "playwright test",
    "screenshot": "UPDATE_PREVIEW=1 playwright test e2e/smoke.spec.js --project=desktop",
    "test:all": "npm test && npm run test:e2e",
    "test:mutants": "node tests/mutants.js",
    "help:update": "UPDATE_HELP=1 playwright test e2e/help.spec.js --project=desktop --grep 'help images'"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@axe-core/playwright": "4.10.2"
  }
}
